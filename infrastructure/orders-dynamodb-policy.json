{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OrdersTableLeastPrivilege",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:Query"
      ],
      "Resource": [
        "arn:aws:dynamodb:${AWS_REGION}:${AWS_ACCOUNT_ID}:table/${TABLE_NAME}",
        "arn:aws:dynamodb:${AWS_REGION}:${AWS_ACCOUNT_ID}:table/${TABLE_NAME}/index/GSI1"
      ],
      "Condition": {
        "StringEquals": {
          "aws:PrincipalTag/kubernetes-namespace": "ecommerce",
          "aws:PrincipalTag/kubernetes-service-account": "orders-api-sa",
          "aws:PrincipalTag/eks-cluster-name": "${CLUSTER_NAME}"
        }
      }
    }
  ]
}
